{
  "name": "Imoveis-Backend",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "dotenv -e .env -- node dist/server.js",
    "start:test": "pnpm build && dotenv -e .env.test -- node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "worker": "node dist/workers.js",    
    "worker:dev": "dotenv -e .env -- tsx watch src/workers.ts",
    "db:migrate:create": "dotenv -e .env -- prisma generate && dotenv -e .env -c -- prisma migrate dev && dotenv -e .env -c -- tsx src/prisma/setupRowLevelSecurityCli.ts",
    "db:migrate": "prisma migrate deploy && tsx src/prisma/setupRowLevelSecurityCli.ts",    
    "vercel-build": "prisma generate && prisma migrate deploy && tsx src/prisma/setupRowLevelSecurityCli.ts && tsup",
    "prisma:generate": "prisma generate",
    "prisma:generate:dev": "dotenv -e .env -- prisma generate",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest watch",
    "test:ui": "dotenv -e .env.test -- vitest --ui",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:e2e": "playwright install --with-deps && playwright test",
    "test:e2e:ui": "playwright install --with-deps && playwright test --ui",
    "test:e2e:headed": "playwright install --with-deps && playwright test --headed",
    "runtime:test": "node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.98.0",
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/s3-presigned-post": "3.1053.0",
    "@aws-sdk/s3-request-presigner": "3.1053.0",
    "@better-auth/api-key": "1.6.11",
    "@better-upload/server": "3.0.19",
    "@hono/node-server": "2.0.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@vercel/functions": "3.6.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.11",
    "dayjs": "1.11.20",
    "file-saver": "2.0.5",
    "filesize": "11.0.17",
    "fs-extra": "11.3.5",
    "hono": "4.12.22",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "lodash-es": "4.18.1",
    "mime": "4.1.0",
    "nodemailer": "8.0.7",
    "papaparse": "5.5.3",
    "pg": "8.21.0",
    "pg-boss": "12.18.2",
    "pg-connection-string": "2.13.0",
    "qs": "6.15.2",
    "sanitize-filename": "1.6.4",
    "stripe": "22.1.1",
    "uniqid": "5.4.0",
    "web-push": "3.6.7",
    "zod": "4.4.3",
    "zod-openapi": "5.4.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/fs-extra": "11.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash-es": "4.17.12",
    "@types/ms": "2.1.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "8.0.0",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.20.0",
    "@types/qs": "6.15.1",
    "@types/uniqid": "5.3.4",
    "@types/web-push": "3.6.4",
    "@vitest/ui": "4.1.7",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "otpauth": "9.5.1",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
