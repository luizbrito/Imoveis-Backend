// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Better Auth fields
  email            String  @unique
  emailVerified    Boolean @default(false)
  name             String  @default("")
  image            String?
  twoFactorEnabled Boolean @default(false)

  // Relations
  members           Member[]
  subscriptions     Subscription[]
  sessions          Session[]
  accounts          Account[]
  apiKeys           ApiKey[]
  pushTokens        PushToken[]
  notifications     Notification[]
  invitations       Invitation[]
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]
  twoFactors        TwoFactor[]
  favoritosPublicos FavoritoPublico[]
}

model AuditLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp           DateTime @default(now()) @db.Timestamptz(3)
  entityName          String
  entityId            String   @db.Uuid // No FK to keep deleted entities logs
  organizationId      String?  @db.Uuid // No FK to keep deleted entities logs
  userId              String?  @db.Uuid // No FK to keep deleted entities logs
  memberId            String?  @db.Uuid // No FK to keep deleted entities logs
  apiKeyId            String?  @db.Uuid // No FK to keep deleted entities logs
  apiEndpoint         String?
  apiHttpResponseCode String?
  operation           String
  oldData             Json?
  newData             Json?
}

// Better Auth API Key model
model ApiKey {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configId    String  @default("default")
  name        String?
  start       String? // Starting characters for display
  prefix      String? // API key prefix
  key         String  @unique // Hashed API key
  referenceId String  @db.Uuid
  user        User    @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  // Organization
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Refill system
  refillInterval Int?
  refillAmount   Int?
  lastRefillAt   DateTime? @db.Timestamptz(3)

  // Status
  enabled Boolean? @default(true)

  // Rate limiting
  rateLimitEnabled    Boolean? @default(true)
  rateLimitTimeWindow Int?     @default(86400000)
  rateLimitMax        Int?     @default(1000)
  requestCount        Int?     @default(0)

  // Usage tracking
  remaining   Int?
  lastRequest DateTime? @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)

  // Timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Permissions and metadata
  permissions String? // JSON string of permissions
  metadata    Json? // Additional metadata

  @@index([organizationId])
}

model PushToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // 'web' or 'mobile' (expo, fcm, apns)
  token          String // For mobile: Expo push token. For web: subscription endpoint
  platform       String? // For mobile: 'ios' or 'android'. Null for web
  p256dh         String? // For web push: encryption key
  auth           String? // For web push: authentication secret
  expirationTime DateTime? @db.Timestamptz(3) // For web push: subscription expiration
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, token])
  @@index([userId])
  @@index([type])
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String    @db.Uuid
  type           String // 'memberAdded', 'memberRemoved', etc.
  roles          String[] // Roles that should receive this notification (e.g., ['admin'])
  payload        Json // Notification-specific data (member details, etc.)
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([organizationId])
  @@index([userId, readAt])
}

