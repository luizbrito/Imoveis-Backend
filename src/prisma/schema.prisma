// Better Auth MCP OAuth Models
model OauthApplication {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?
  icon         String?
  metadata     String?
  clientId     String?  @unique
  clientSecret String?
  redirectUrls String?
  type         String?
  disabled     Boolean? @default(false)
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]
}

model OauthAccessToken {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessToken           String?           @unique
  refreshToken          String?           @unique
  accessTokenExpiresAt  DateTime?         @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime?         @db.Timestamptz(3)
  clientId              String?
  oauthapplication      OauthApplication? @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?           @db.Uuid
  user                  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
}

model OauthConsent {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String?
  oauthapplication OauthApplication? @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String?           @db.Uuid
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes           String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  consentGiven     Boolean?
}
